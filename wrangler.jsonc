{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none" },
  "observability": { "enabled": true },
  "vars": {
    // Set to "1" in production so requests without a Cloudflare Access identity are rejected.
    "REQUIRE_ACCESS": "0",
    // "true" switches the device gate off: any browser is enrolled automatically on first visit.
    "LIBERADO": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance",
      // From `wrangler d1 create finance`.
      "database_id": "7b8e324a-c252-4027-adc1-5934f762b6ec",
      "migrations_dir": "migrations"
    }
  ]
}
