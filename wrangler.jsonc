{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none" },
  "observability": { "enabled": true },
  "vars": {
    // Set to "1" in production so requests without a Cloudflare Access identity are rejected.
    "REQUIRE_ACCESS": "0",
    // Admins: manage categories, budgets, reports, users, IPs and read the access log.
    "ADMIN_EMAILS": "admin@example.com,partner@example.com",
    // "true" switches the IP + device gates off: any browser is approved on first visit. Dev only.
    "LIBERADO": "false"
    // Optional secrets (wrangler secret put): BREVO_API_KEY and EMAIL_FROM for e-mailing access codes.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance",
      // From `wrangler d1 create finance`.
      "database_id": "7b8e324a-c252-4027-adc1-5934f762b6ec",
      "migrations_dir": "migrations"
    }
  ]
}
