{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none" },
  "observability": { "enabled": true },
  // D1 lives in the US; running the Worker next to it turns N database round trips into one.
  "placement": { "mode": "smart" },
  "vars": {
    // Set to "1" in production so requests without a Cloudflare Access identity are rejected.
    "REQUIRE_ACCESS": "0",
    // "true" switches the IP + device gates off: any browser is approved on first visit. Dev only.
    "LIBERADO": "false"
    // Secrets (wrangler secret put, or .dev.vars locally), never in this file:
    //   ADMIN_EMAILS  required, comma-separated app admins (approve devices, IPs, users, access log)
    //   BREVO_API_KEY + EMAIL_FROM  optional, e-mail access codes to the admins
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance",
      // From `wrangler d1 create finance`. Replace it with your own database's id when you deploy a copy.
      "database_id": "7b8e324a-c252-4027-adc1-5934f762b6ec",
      "migrations_dir": "migrations"
    }
  ]
}
